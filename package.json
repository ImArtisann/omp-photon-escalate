{
    "name": "omp-photon-escalate",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "omp": {
        "extensions": [
            "./src/main.ts"
        ]
    },
    "dependencies": {
        "spectrum-ts": "12.7.0"
    },
    "devDependencies": {
        "@oh-my-pi/pi-coding-agent": "^17.3.7",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "typescript": "^5.9.0"
    },
    "scripts": {
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint . --no-error-on-unmatched-pattern",
