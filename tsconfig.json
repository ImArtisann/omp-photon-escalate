{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2024"],
        "module": "Preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "types": []
    },
    "include": ["src/**/*.ts"]
}
